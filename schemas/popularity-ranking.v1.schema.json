{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9batalion.github.io/coderisktools-observatory-reports/schemas/popularity-ranking.v1.schema.json",
  "title": "CodeRiskTools vulnerability ranking for public popularity cohort",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "week", "generated_at", "cohort", "provenance", "publication", "entries", "limitations"],
  "properties": {
    "schema": {"const": "coderisktools.observatory.vulnerability-ranking.v1"},
    "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cohort": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "metric", "snapshot_at", "tie_break", "size"],
      "properties": {
        "schema": {"const": "coderisktools.public-popularity-cohort.v1"},
        "metric": {"const": "stargazers_count"},
        "snapshot_at": {"type": "string", "format": "date-time"},
        "tie_break": {"const": "repository lexicographic ascending"},
        "size": {"const": 15}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["scanner_version", "scanner_command", "scanner_source_commit", "vulnerability_database_profile", "vulnerability_database_snapshot", "vulnerability_database_records", "vulnerability_database_completeness"],
      "properties": {
        "scanner_version": {"const": "3.1.1"},
        "scanner_command": {"const": "secret-scanner vuln scan --root"},
        "scanner_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "vulnerability_database_profile": {"const": "osv-partial"},
        "vulnerability_database_snapshot": {"const": "osv-partial-2026-07-23"},
        "vulnerability_database_records": {"const": 243381},
        "vulnerability_database_completeness": {"const": "partial-osv-prefix"}
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "security_ranking", "raw_findings", "locations", "package_urls", "evidence"],
      "properties": {
        "purpose": {"const": "POPULARITY_COHORT_VULNERABILITY_RANKING"},
        "security_ranking": {"const": true},
        "raw_findings": {"const": "NOT_PUBLISHED"},
        "locations": {"const": "NOT_PUBLISHED"},
        "package_urls": {"const": "NOT_PUBLISHED"},
        "evidence": {"const": "NOT_PUBLISHED"}
      }
    },
    "entries": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["vulnerability_rank", "rank", "repository", "repository_url", "head_sha", "expected_sha", "sha_match", "stars", "license_spdx", "scan_status", "scan_exit_code", "publication_status", "vulnerability_counts", "ranking_score"],
        "properties": {
          "vulnerability_rank": {"type": "integer", "minimum": 1, "maximum": 15},
          "rank": {"type": "integer", "minimum": 1, "maximum": 15},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,39}/[A-Za-z0-9_.-]{1,100}$"},
          "repository_url": {"type": "string", "format": "uri"},
          "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "expected_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "sha_match": {"const": true},
          "stars": {"type": "integer", "minimum": 0},
          "license_spdx": {"type": ["string", "null"]},
          "scan_status": {"const": "complete"},
          "scan_exit_code": {"const": 0},
          "publication_status": {"const": "PUBLIC_NUMERIC_SUMMARY"},
          "vulnerability_counts": {
            "type": "object", "additionalProperties": false,
            "required": ["critical", "high", "medium", "low", "unknown", "total"],
            "properties": {
              "critical": {"type": "integer", "minimum": 0},
              "high": {"type": "integer", "minimum": 0},
              "medium": {"type": "integer", "minimum": 0},
              "low": {"type": "integer", "minimum": 0},
              "unknown": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0}
            }
          },
          "ranking_score": {"type": "integer", "minimum": 0}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}
  }
}
